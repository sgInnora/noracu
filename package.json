{
  "name": "noracu",
  "version": "0.2.6",
  "mcpName": "io.github.sgInnora/noracu",
  "description": "Local MCP server: macOS apps and a browser by element index, plus iPhone Mirroring (experimental).",
  "type": "module",
  "main": "src/server.mjs",
  "bin": {
    "noracu": "src/server.mjs"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node test/engine-unit.mjs && node test/e2e.mjs",
    "test:ci": "node test/engine-unit.mjs && NORACU_CI=1 node test/e2e.mjs",
    "test:imctl": "cd imctl && ${NORACU_PYTHON:-python3} tests/test_smoke.py",
    "check": "node --check src/server.mjs && node --check src/mac-ax.js && node --check scripts/gen-tools.mjs && python3 -c \"import ast,sys; [ast.parse(open(f).read(), f) for f in sys.argv[1:]]\" imctl/src/imctl/*.py",
    "prepublishOnly": "npm run check && node scripts/check-pack.mjs && node scripts/gen-tools.mjs && git diff --exit-code docs/tools.md"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "computer-use",
    "playwright",
    "macos",
    "macos-automation",
    "browser-automation",
    "claude",
    "claude-desktop",
    "claude-code",
    "cursor",
    "iphone",
    "iphone-mirroring"
  ],
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.58.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sgInnora/noracu.git"
  },
  "homepage": "https://github.com/sgInnora/noracu#readme",
  "bugs": {
    "url": "https://github.com/sgInnora/noracu/issues"
  },
  "author": "sgInnora",
  "files": [
    "src",
    "docs/architecture.md",
    "docs/tools.md",
    "docs/usage.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "imctl/README.md",
    "imctl/LICENSE",
    "imctl/pyproject.toml",
    "imctl/src/imctl/*.py"
  ]
}
